      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "sum by (archive_kind) (increase(solparq_archives_created_total{archive_kind=~\"$archive_kind\"}[$__rate_interval]))", "legendFormat": "{{archive_kind}}", "range": true, "refId": "A" }
      ],
      "title": "Archives created",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal" } }, "unit": "short" },

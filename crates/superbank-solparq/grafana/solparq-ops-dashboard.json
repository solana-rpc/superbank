      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "sum by (reason) (increase(solparq_archives_skipped_total{archive_kind=~\"$archive_kind\"}[$__rate_interval]))", "legendFormat": "{{reason}}", "range": true, "refId": "A" }
      ],
      "title": "Archives skipped by reason",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 23,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "sum by (table) (increase(solparq_archive_rows_total{archive_kind=~\"$archive_kind\"}[$__rate_interval]))", "legendFormat": "{{table}}", "range": true, "refId": "A" }
      ],
      "title": "Rows archived by table",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },

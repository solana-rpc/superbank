          { "matcher": { "id": "byName", "options": "transaction_mismatch" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "not_produced" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 39 },
      "id": 42,

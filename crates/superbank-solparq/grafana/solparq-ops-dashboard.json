        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "solparq_chain_tip_slot", "legendFormat": "network tip", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "solparq_db_latest_slot", "legendFormat": "clickhouse latest", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "max by (archive_kind) (solparq_last_archived_end_slot{archive_kind=~\"$archive_kind\"})", "legendFormat": "archived end · {{archive_kind}}", "range": true, "refId": "C" }
      ],
      "title": "Slot positions (network vs ClickHouse vs archived)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 8, "showPoints": "never", "lineWidth": 2 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "solparq_chain_tip_lag_slots", "legendFormat": "chain tip lag", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "solparq_db_lag_slots{archive_kind=~\"$archive_kind\"}", "legendFormat": "archive lag · {{archive_kind}}", "range": true, "refId": "B" }
      ],
      "title": "Lag (slots)",

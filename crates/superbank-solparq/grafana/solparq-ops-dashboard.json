      ],
      "title": "Last archive rows",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 50, "showPoints": "never", "lineWidth": 1 }, "unit": "short" },

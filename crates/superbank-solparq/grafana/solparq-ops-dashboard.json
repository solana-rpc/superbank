      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 23 },
      "id": 24,
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto"
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "sum(solparq_last_archive_bytes{archive_kind=~\"$archive_kind\"})", "legendFormat": "last bytes", "range": true, "refId": "A" }
      ],
      "title": "Last archive size (local)",
